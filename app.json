{
  "expo": {
    "name": "تك توكي",
    "slug": "tuktuki",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "tuktuki",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tuktuki.app"
    },
    "android": {
      "package": "com.tuktuki.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "config": {
        "googleMaps": {
          "apiKey": "ضع_مفتاح_خرائط_جوجل_هنا"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم تطبيق تك توكي موقعك لتحديد موقعك وعرض السائقين القريبين ومتابعة الرحلة."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F5A623"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
